{
  "name": "compass",
  "main": "src/index.ts",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^24.0.0"
  },
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "build": "next build && cp -r ./prompts ./.next/prompts",
    "build:clean": "rm -rf ./next",
    "dev": "genkit start -- npx nodemon --ext prompt --watch prompts --exec next dev",
    "dev:next": "next dev",
    "dev:genkit": "genkit start -- npx nodemon --ext prompt --watch prompts --exec \"tsx --watch src/index.ts\"",
    "lint": "eslint src"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.44.0",
    "@genkit-ai/vertexai": "^1.44.0",
    "clsx": "^2.1.1",
    "genkit": "^1.12.0",
    "next": "^15.5.29",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "genkit-cli": "^1.45.0",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.5.3",
    "@tailwindcss/postcss": "4.3.5"
  }
}
